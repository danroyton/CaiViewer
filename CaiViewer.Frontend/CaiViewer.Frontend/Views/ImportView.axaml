<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:CaiViewer.Frontend.ViewModels"
			 x:Class="CaiViewer.Frontend.Views.ImportView"
			 x:DataType="vm:ImportViewModel">

  <DockPanel Margin="12">

	<!-- Top: path + controls -->
	<StackPanel DockPanel.Dock="Top" Spacing="8">
	  <TextBlock Text="📥 Import ZIP Archives into Database" FontSize="16" FontWeight="SemiBold" />

	  <Grid ColumnDefinitions="*,Auto">
		<TextBox Grid.Column="0" Text="{Binding RootPath}" Watermark="Root directory containing ZIP archives…" />
		<Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseRootPathCommand}" Margin="4,0,0,0" />
	  </Grid>

	  <CheckBox Content="Recursive (include subdirectories)" IsChecked="{Binding Recursive}" />

	  <StackPanel Orientation="Horizontal" Spacing="8">
		<Button Content="▶ Scan Directory" Command="{Binding ScanDirectoryCommand}"
				IsEnabled="{Binding !IsRunning}" />
		<Button Content="⏹ Cancel" Command="{Binding CancelScanCommand}"
				IsVisible="{Binding IsRunning}" />
		<ProgressBar IsIndeterminate="True" Width="200" IsVisible="{Binding IsRunning}" />
	  </StackPanel>

	  <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" Foreground="#66BB66"
				 IsVisible="{Binding SummaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
	</StackPanel>

	<!-- Log output -->
	<Border DockPanel.Dock="Bottom" BorderBrush="#333" BorderThickness="1" Margin="0,8,0,0">
	  <ScrollViewer MaxHeight="400">
		<ItemsControl ItemsSource="{Binding LogLines}">
		  <ItemsControl.ItemTemplate>
			<DataTemplate>
			  <TextBlock Text="{Binding}" FontFamily="Monospace" FontSize="11"
						 Foreground="{Binding StringFormat='{}{0}',
						   Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
			</DataTemplate>
		  </ItemsControl.ItemTemplate>
		</ItemsControl>
	  </ScrollViewer>
	</Border>

  </DockPanel>

</UserControl>
